# Vite exposes env vars prefixed with VITE_ to the browser bundle.
# Copy this file to .env.local and fill in real values for local development.
# In Vercel, add these under Project Settings > Environment Variables.

VITE_API_BASE_URL=https://api.example.com
VITE_API_BEARER_TOKEN=your-bearer-token-here
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_TURNSTILE_SITE_KEY=0x00000000000000000000FF
VITE_ENABLE_COMMUNITY_SENTIMENT=false
